# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is git-ignored. NEVER commit real credentials.

# --- Database: your local MySQL. createDatabaseIfNotExist=true creates the "teamcanvas" database on first start ---
DB_URL=jdbc:mysql://localhost:3306/teamcanvas?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your-mysql-root-password

# --- JWT (must be at least 32 characters) ---
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# --- Refresh-token cookie ---
# Local development over http: COOKIE_SECURE=false. In production (https): true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- CORS (comma-separated list of exact origins, no wildcards) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
